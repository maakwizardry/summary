# Server Configuration
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/briefme

# Google Gemini AI (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (REQUIRED) - Change this to a random string
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string_min_32_chars

# Email Configuration (REQUIRED for OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Lemon Squeezy Payment (Optional)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
